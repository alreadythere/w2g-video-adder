{
  "manifest_version": 3,
  "name": "W2G Video Adder",
  "version": "1.0",
  "description": "Add YouTube videos to W2G room with right-click",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["*://*.youtube.com/*", "https://api.w2g.tv/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
